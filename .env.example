# ==================================================
# CodeForge Environment Variables
# Copy this file to .env and replace the placeholder
# values with your own Supabase credentials.
# ==================================================

# Supabase Project ID
SUPABASE_PROJECT_ID=your_supabase_project_id

# Supabase URL
SUPABASE_URL=https://your-project-id.supabase.co

# Public URL for Vite
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public API Key (safe for frontend)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Public API Key for Vite
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Server-only Service Role Key
# Never expose this key publicly.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key
